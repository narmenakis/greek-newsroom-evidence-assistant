# The local Mac demonstration starts with Ollama. The Streamlit sidebar can
# switch to hosted DeepSeek at runtime without changing this file.
RAG_LLM_PROVIDER=ollama
DEEPSEEK_API_KEY=
RAG_LLM_MODEL=journalism-rag-qwen3.5:9b
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_TIMEOUT_SECONDS=60
RAG_LLM_MAX_RETRIES=2
RAG_LLM_MAX_TOKENS=8192
RAG_LLM_TEMPERATURE=0.1
RAG_OLLAMA_REASONING_EFFORT=none
# DeepSeek V4.1-Flash thinking is disabled by default; set to enabled when desired.
RAG_DEEPSEEK_THINKING=disabled
RAG_ENABLE_LOGGING=0
RAG_SHOW_DIAGNOSTICS=0

# Apple Silicon retrieval profile used by the local demonstration.
RAG_EMBEDDING_DEVICE=mps

# Optional local reranking for the demonstration (requires the checkpoint to
# already be cached; the app never downloads it automatically):
RAG_RERANKER_ENABLED=1
RAG_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RAG_RERANKER_DEVICE=mps
RAG_RERANKER_CANDIDATE_LIMIT=20
RAG_RERANKER_EVIDENCE_LIMIT=5
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANKER_MAX_LENGTH=256
# Alternative modular backend, measured but currently not selected:
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional live research briefs through the Tavily MCP server:
RAG_TAVILY_MCP_URL=https://mcp.tavily.com/mcp
RAG_TAVILY_TIMEOUT_SECONDS=30
TAVILY_API_KEY=

# Hosted DeepSeek is selected from the sidebar. Its runtime profile uses
# deepseek-flash (V4.1-Flash) and 8,192 output tokens; its API key remains empty here.
